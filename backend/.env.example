# Anthropic
ANTHROPIC_API_KEY=

# Supabase（Project Settings > API から取得）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 自前セッションJWT署名用（openssl rand -hex 32 などで生成）
SESSION_SECRET=

# Google OAuth（Google Cloud Console > APIs & Services > 認証情報）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Microsoft OAuth（Azure Portal > アプリの登録）
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/outlook/callback
MICROSOFT_TENANT=consumers

# PWAのオリジン（CORS許可用。本番デプロイ後は実URLに変更）
FRONTEND_ORIGIN=http://localhost:5173
