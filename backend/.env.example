# Anthropic
ANTHROPIC_API_KEY=

# Supabase（Project Settings > API から取得）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 自前セッションJWT署名用（openssl rand -hex 32 などで生成）
SESSION_SECRET=

# Google OAuth（Google Cloud Console > APIs & Services > 認証情報）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Microsoft OAuth（Azure Portal > アプリの登録）
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/auth/outlook/callback
MICROSOFT_TENANT=consumers

# PWAのオリジン（CORS許可用。本番デプロイ後は実URLに変更）
FRONTEND_ORIGIN=http://localhost:5173

# Web Push（リマインダー・朝のブリーフィングの配信）
# 鍵の生成: python -c "import base64;from cryptography.hazmat.primitives.asymmetric import ec;
#   from cryptography.hazmat.primitives import serialization as s;k=ec.generate_private_key(ec.SECP256R1());
#   print('public :',base64.urlsafe_b64encode(k.public_key().public_bytes(s.Encoding.X962,s.PublicFormat.UncompressedPoint)).rstrip(b'=').decode());
#   print('private:',base64.urlsafe_b64encode(k.private_bytes(s.Encoding.DER,s.PrivateFormat.PKCS8,s.NoEncryption())).rstrip(b'=').decode())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 配信ジョブを外部から手動で叩くための共有シークレット（未設定だとジョブAPIは503を返す）
CRON_SECRET=

# 配信ループをアプリ内で回すか。false にすると外部Cronからの起動のみになる
ENABLE_SCHEDULER=true
